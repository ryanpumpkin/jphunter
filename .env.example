# 複製呢個檔做 .env 再填。唔填 Telegram 就唔會推通知（淨係喺 log 顯示）。

# ── Telegram（而家唯一啟用嘅通知渠道）──
# 1. Telegram 搵 @BotFather → /newbot → 攞 token
# 2. 同你個新 bot 傾一句偈，再開 https://api.telegram.org/bot<token>/getUpdates 攞你嘅 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 管理員 token ──
# 保護所有「改追蹤／發訊息」嘅 API。唔設＝本機開發模式，完全唔限制；
# 出街（NAS/公網）之前一定要設，否則任何人都改到你嘅追蹤兼借你個 bot 發訊息。
ADMIN_TOKEN=

# ── 存放位置（Docker 會覆寫成 /app/data，掛 volume 先持久化）──
# DB_PATH=./server/jphunter.db
# DATA_DIR=./server

# ── 伺服器 port ──
# PORT=3000
